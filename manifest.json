{
  "manifest_version": 3,
  "name": "Chat Watchdog",
  "version": "0.1.5",
  "description": "Per-tab auto-continue and error sound for AI chats.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chat Watchdog",
    "default_popup": "popup.html"
  }
}
