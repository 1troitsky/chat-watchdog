{
  "manifest_version": 3,
  "name": "Chat Watchdog",
  "version": "0.2.21",
  "description": "Per-tab auto-continue, repeated error alarms, and one-time reply completion audio.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab",
    "offscreen",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chat Watchdog",
    "default_popup": "popup.html"
  }
}
